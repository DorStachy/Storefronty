# Copy this file to ".env" and fill in. The .env file is git-ignored.

# review = pause customer-facing sends for your approval (month 1). auto = send automatically.
MODE=review

# Researcher: "mock" (offline fake data) or "places" (real Google Places API)
RESEARCHER_ENGINE=places
GOOGLE_PLACES_KEY=

# Web search for website + social discovery. Serper.dev: 2,500 free credits, then ~$1/1k.
# Without this, the researcher falls back to the Places-only signal (weaker).
SEARCH_ENGINE=serper
SERPER_API_KEY=

# Test inbox = your throwaway Gmail (acts as the "business" address: sends + receives replies)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# During local testing, every cold email is delivered HERE instead of the real shop:
TEST_RECIPIENT=
# Where approval/notification emails are sent (your personal inbox):
FOUNDER_EMAIL=

# Branding / CAN-SPAM
FROM_NAME=Michael
BRAND=Storefronty
POSTAL_ADDRESS=Storefronty LLC, 123 Main St, Austin, TX 78701

# Public base URL for the live preview links (a local server now; Cloudflare Pages later)
PUBLIC_BASE_URL=http://localhost:4173

# Local DB file (leave default)
# DB_PATH=
